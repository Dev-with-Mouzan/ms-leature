# Signs the admin session cookie. Required. Without it /admin/login returns 503.
ADMIN_TOKEN_SECRET=
# Credentials for the first `python -m api.seed` run. Ignored afterwards.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Session lifetime in seconds. Default 43200 (12h).
ADMIN_TOKEN_TTL=

# SQLite locally, Postgres in production.
DATABASE_URL=sqlite:///./api.db

# Canonical origin. Used for SEO tags, JSON-LD and the sitemap.
SITE_URL=http://localhost:8000

# Contact form recipient.
CONTACT_EMAIL=