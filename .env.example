# Reviews database (https://turso.tech). Both server-only: never prefix NEXT_PUBLIC_.
# Leave both unset locally and the site writes to reviews.db in the project root.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Canonical origin for production. Required — canonicals, OG tags and the
# sitemap are built from it, and it falls back to localhost without it.
NEXT_PUBLIC_SITE_URL=

# Real inbox address. The built-in fallback is a placeholder.
NEXT_PUBLIC_CONTACT_EMAIL=